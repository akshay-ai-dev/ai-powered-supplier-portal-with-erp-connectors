# =============================================================================
# SRS Supplier Portal (Prototype) — environment variables
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is never committed; only this file lives in the repo (SRS §9.1).
# Demo data only — no real supplier, customer or personal data, and no real
# ERP credentials in the prototype (SRS §8).
#
# Variables marked [spec] come straight from SRS §9.5. Everything else is a
# suggested default derived from the rest of the spec.
#
# One .env at the repo root serves both apps: the backend loads ../.env and
# Vite reads it via `envDir: ".."`. Relative paths below resolve from
# backend/ (the backend's working directory).
# =============================================================================


# -----------------------------------------------------------------------------
# App / runtime
# -----------------------------------------------------------------------------
APP_ENV=development                      # development | test | demo
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
TZ=UTC                                   # all dates stored/returned as ISO 8601 UTC (SRS §9.2)


# -----------------------------------------------------------------------------
# Backend — FastAPI REST API (SRS §2.1, §5.1)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Frontend origins allowed to call the API (comma-separated)
CORS_ALLOW_ORIGINS=http://localhost:5173
# Public URL of the portal — used for links in email alerts back into the portal (SRS §3.1)
PORTAL_BASE_URL=http://localhost:5173


# -----------------------------------------------------------------------------
# Frontend — React + Vite (SRS §2.1)
# Only VITE_-prefixed vars are exposed to the browser. NEVER put secrets here.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME="SRS Supplier Portal"


# -----------------------------------------------------------------------------
# AI — Claude API (SRS §2.1, §6)
# Server-side only; never exposed to the frontend (SRS §8).
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-replace-me       # [spec] secret, never committed
CLAUDE_MODEL=claude-sonnet-5-5            # [spec] final model ID set at kick-off
AI_MAX_TOKENS=4096                        # max output tokens per assistant / pre-fill call
AI_TEMPERATURE=0                          # keep answers deterministic for the 10 test prompts
AI_REQUEST_TIMEOUT_SECONDS=60
# Packing-list pre-fill (SRS §6.2)
AI_PREFILL_ENABLED=true                   # first item on the cut list if time runs short (SRS §10)

# In-app chat assistant: natural-language "fill this form with AI" (OpenAI structured outputs).
# Leave OPENAI_API_KEY empty to disable it; the numbered-menu assistant works without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o


# -----------------------------------------------------------------------------
# MCP server — business-task tools for the AI (SRS §2.1, §6.1)
# -----------------------------------------------------------------------------
MCP_SERVER_NAME=supplier-portal
MCP_TRANSPORT=stdio                       # stdio | streamable-http
MCP_HOST=127.0.0.1                        # used only when MCP_TRANSPORT=streamable-http
MCP_PORT=8001


# -----------------------------------------------------------------------------
# Database — SQLite (WAL mode) via SQLAlchemy/SQLModel + Alembic (SRS §2.1, §3)
# Switch to PostgreSQL later by changing DATABASE_URL only.
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/portal.db   # [spec] SQLite database file
SEED_DB_PATH=./seed/seed.db               # [spec] clean seed database used by reset
DATABASE_ECHO=false                       # log SQL statements (debug only)


# -----------------------------------------------------------------------------
# Unit-by-unit inspection — QR-coded units, per-unit test results, lot report
# -----------------------------------------------------------------------------
# Quality accuracy (OK units / received units, in percent) at or above which the lot report suggests approving
INSPECTION_ACCEPT_THRESHOLD=95
# The most units one shipment can track individually (each unit gets its own QR code)
INSPECTION_MAX_UNITS=2000
# The address of the web app as phones and other devices reach it. Every QR label encodes {PUBLIC_APP_URL}/units/{code},
# so scanning one with a phone camera opens that unit. Use your domain in production, or this computer's address on a
# local network (a bare host such as erp.example.com is normalised to https://erp.example.com):
#   PUBLIC_APP_URL=https://erp.yourcompany.com
#   PUBLIC_APP_URL=http://192.168.1.44:3000
# Empty = the labels use the address the supplier's browser is on (wrong when that is localhost).
PUBLIC_APP_URL=


# -----------------------------------------------------------------------------
# File storage — local disk (SRS §2.1)
# Request drawings/specs, message attachments, inspection photos, packing lists.
# -----------------------------------------------------------------------------
FILE_STORAGE_PATH=./data/files            # [spec] attachments and photos
MAX_UPLOAD_SIZE_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,webp


# -----------------------------------------------------------------------------
# Email alerts — one-way SMTP to Mailpit (SRS §2.1, §3.1, §8)
# No real emails leave the environment in the prototype.
# -----------------------------------------------------------------------------
EMAIL_ALERTS_ENABLED=true                 # second item on the cut list (bell stays)
SMTP_HOST=localhost                       # [spec] Mailpit
SMTP_PORT=1025                            # [spec] Mailpit SMTP port
SMTP_USERNAME=                            # not needed for Mailpit
SMTP_PASSWORD=                            # not needed for Mailpit
SMTP_USE_TLS=false
SMTP_FROM_ADDRESS=no-reply@supplier-portal.local
SMTP_FROM_NAME="SRS Supplier Portal"
MAILPIT_UI_PORT=8025                      # Mailpit web UI: http://localhost:8025


# -----------------------------------------------------------------------------
# Background jobs — deadline locking & alerts (SRS §3, §4 step 5)
# FastAPI background tasks / APScheduler.
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
DEADLINE_CHECK_INTERVAL_SECONDS=60        # how often to lock requests past their deadline


# -----------------------------------------------------------------------------
# ERP adapters (SRS §5)
# Swapping a mock for a real adapter changes only the adapter module (SRS §8).
# -----------------------------------------------------------------------------
SAP_ADAPTER=mock                          # mock | real (real = phase 2)
LN_ADAPTER=mock                           # mock | real (real = phase 2)

# Default mock ERP behaviour — adjustable at runtime in Admin > Settings (SRS §3.5, §5.3)
MOCK_LATENCY_MS=0                         # [spec] 0–2000 ms
MOCK_FAILURE_RATE=0                       # [spec] 0–0.5 (i.e. 0–50%)

# Connector core — retries on transient ERP errors (SRS §2.1)
ERP_MAX_RETRIES=3
ERP_RETRY_BACKOFF_MS=500
ERP_REQUEST_TIMEOUT_SECONDS=30


# -----------------------------------------------------------------------------
# Phase 2 — real ERP connections (NOT used by the prototype; SRS §5.4, §12)
# Left commented out on purpose. No real ERP credentials in the prototype.
# -----------------------------------------------------------------------------
# --- SAP S/4HANA (OData over HTTPS) ---
# SAP_BASE_URL=https://my-s4-host.example.com
# SAP_CLIENT=100
# SAP_USERNAME=
# SAP_PASSWORD=
# --- SAP Business Accelerator Hub sandbox (read-only, API key) ---
# SAP_API_HUB_URL=https://sandbox.api.sap.com
# SAP_API_HUB_KEY=
# --- SAP ECC over RFC (needs a small SAP JCo Java side service) ---
# SAP_JCO_SERVICE_URL=http://localhost:9090

# --- Infor LN via ION API Gateway (OAuth 2.0) ---
# LN_ION_API_BASE_URL=https://mingle-ionapi.example.com
# LN_TENANT_ID=
# LN_COMPANY=
# LN_OAUTH_TOKEN_URL=
# LN_OAUTH_CLIENT_ID=
# LN_OAUTH_CLIENT_SECRET=
# LN_SERVICE_ACCOUNT_ACCESS_KEY=
# LN_SERVICE_ACCOUNT_SECRET_KEY=