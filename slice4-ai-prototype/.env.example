# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
AI_REQUEST_TIMEOUT_SECONDS=60
# Data source for the AI tools. Only "sample" ships in this demo.
PORTAL_DATA_SOURCE=sample
# Demo exchange rate for comparing USD offers with INR offers (sample data, not a live rate).
DEMO_USD_INR_RATE=85
